{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwilightMC",
  "identifier": "io.github.blackcatofficialytb.twilightmc",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TwilightMC (pre-release UI)",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
