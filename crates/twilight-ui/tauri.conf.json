{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwilightMC",
  "identifier": "io.github.blackcatofficialytb.twilightmc",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TwilightMC",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "theme": "Dark",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
